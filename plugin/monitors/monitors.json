[
  {
    "name": "forge-ci",
    "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/monitors/ci-watch.mjs\"",
    "description": "CI status on the current branch's PR (autopilot merge bar)",
    "when": "on-skill-invoke:autopilot"
  },
  {
    "name": "forge-decisions",
    "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/monitors/decisions-watch.mjs\"",
    "description": "Answered escalation decisions (.forge/decisions)",
    "when": "on-skill-invoke:autopilot"
  },
  {
    "name": "forge-outbox",
    "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/monitors/outbox-watch.mjs\"",
    "description": "Local GitHub outbox drain status (.forge/autopilot/outbox.json)",
    "when": "on-skill-invoke:autopilot"
  },
  {
    "name": "forge-agents",
    "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/monitors/agents-watch.mjs\"",
    "description": "Delivery subagent liveness heartbeat (.forge/agents) — detects a subagent that never returns",
    "when": "on-skill-invoke:autopilot"
  }
]
